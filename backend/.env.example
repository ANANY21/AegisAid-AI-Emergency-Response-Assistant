# AegisAid - AI Emergency Response Assistant
# Environment Configuration Template

# 1. LLM API Key (Groq)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
GROQ_VISION_MODEL=qwen/qwen3.8-27b
GROQ_TIMEOUT_SECONDS=20.0

# 2. Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=True
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:3000"]

# 3. Database
DATABASE_URL=sqlite:///./data/emergency_assistant.db

# 4. OpenStreetMap API Keys (Primary / Recommended)
# Provide your OpenStreetMap ecosystem API key from LocationIQ, Geoapify, OpenRouteService, Thunderforest, or Stadia Maps:
OPENSTREETMAP_API_KEY=your_openstreetmap_api_key_here
OSM_API_KEY=your_osm_api_key_here
LOCATIONIQ_API_KEY=pk.your_locationiq_token_here
GEOAPIFY_API_KEY=your_geoapify_key_here
OPENROUTESERVICE_API_KEY=your_openrouteservice_key_here

# 5. Google Maps Platform API Key (Optional alternative)
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# 6. RAG Retrieval & Safety Thresholds
RETRIEVAL_SIMILARITY_THRESHOLD=0.55
RETRIEVAL_TOP_K=4
CRITICAL_BYPASS_ENABLED=True
CLASSIFIER_CONFIDENCE_THRESHOLD=0.60
ENABLE_CROSS_ENCODER_RERANKING=True

# 6. Fallback OpenStreetMap / Nominatim Configuration
OVERPASS_API_URL=https://overpass-api.de/api/interpreter
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
DEFAULT_SEARCH_RADIUS_METERS=5000
