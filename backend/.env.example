# AI Emergency Response Assistant - Environment Configuration
# GROQ API Configuration
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=False
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:3000"]

# Database Configuration
DATABASE_URL=sqlite:///./data/emergency_assistant.db

# Retrieval & Safety Thresholds
RETRIEVAL_SIMILARITY_THRESHOLD=0.55
RETRIEVAL_TOP_K=4
CRITICAL_BYPASS_ENABLED=True
CLASSIFIER_CONFIDENCE_THRESHOLD=0.60
ENABLE_CROSS_ENCODER_RERANKING=True

# Medical Facility Service
OVERPASS_API_URL=https://overpass-api.de/api/interpreter
DEFAULT_SEARCH_RADIUS_METERS=7500
